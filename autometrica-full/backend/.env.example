# Copia este archivo a ".env" para desarrollo local. NUNCA subas ".env" a GitHub.
# En Render estas variables se configuran en el panel (Environment), no en un archivo.

ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/autometrica_db
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=https://otro-dominio.com

# Correo por HTTPS (recomendado; funciona en Render free)
RESEND_API_KEY=
RESEND_FROM=AutoMétrica <onboarding@resend.dev>

# SMTP (solo local: Render free bloquea los puertos 25/465/587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AutoMétrica
SMTP_FROM_EMAIL=

# SMS (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Superusuario (lo crea build.sh; opcional en local)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
